---
import Base from '../../layouts/Base.astro';
import {cats,tools,SITE} from '../../data/tools.mjs';
import {iconFor} from '../../lib/icons.mjs';
import {HUBKW} from '../../data/keywords.mjs';
import {CATINFO,SEARCHES} from '../../data/categories.mjs';
import {LANGS} from '../../i18n/index.mjs';
export async function getStaticPaths(){const {cats}=await import('../../data/tools.mjs');return cats.map(x=>({params:{id:x.path},props:{c:x}}))}
const {c}=Astro.props;const ts=tools.filter(t=>t.cat===c.slug);const lv=ts.filter(t=>t.live);const info=CATINFO[c.slug]||`Free ${c.name.toLowerCase()} that run in your browser. No signup needed.`;
const url=`${SITE}/category/${c.path}/`;
const ld=[{'@type':'CollectionPage',name:`${c.name}: Free Online Tools`,url,description:info,isPartOf:{'@type':'WebSite',name:'Worlds Best Free Tools',url:SITE+'/'}},
{'@type':'ItemList',numberOfItems:lv.length,itemListElement:lv.map((t,i)=>({'@type':'ListItem',position:i+1,name:t.name,url:`${SITE}/${t.slug}/`}))},
{'@type':'BreadcrumbList',itemListElement:[['Home',SITE+'/'],[c.name,url]].map(([name,item],i)=>({'@type':'ListItem',position:i+1,name,item}))}];
const alts=Object.entries(LANGS).filter(([k,X]:any)=>ts.some(t=>t.live&&X.tools[t.slug])).length?[{lang:'en',code:'en',gt:'en',name:'English',url:`/category/${c.path}/`},...Object.entries(LANGS).filter(([k,X]:any)=>ts.some(t=>t.live&&X.tools[t.slug])).map(([k,X]:any)=>({lang:X.hreflang,code:k,gt:X.gt,name:X.name,url:`/${k}/category/${c.path}/`}))]:[];
const sr=(SEARCHES[c.slug]||[]).filter(([,sl])=>lv.some(t=>t.slug===sl));
const names=lv.slice(0,5).map(t=>t.name);
const faq=[[`What free ${c.name.toLowerCase()} are available?`,`Worlds Best Free Tools has ${lv.length} free tools in this category, including ${names.join(', ')}${lv.length>5?' and more':''}. They work in your browser on phone and desktop.`],['Do I need to sign up to use these tools?','No signup is needed. Most tools run in your browser, so your files and text stay on your device. If a tool needs the internet, for example for live exchange rates, its page says so.'],[`Where should I start in ${c.name}?`,`A good starting point is ${lv[0]?.name||'any tool above'}. Each tool page explains what it does, how to use it step by step and answers common questions.`]];
ld.push({'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
const desc=info.length>158?info.slice(0,155).replace(/\s+\S*$/,'')+'…':info;
---
<Base title={`${c.name}: Free Online Tools, No Signup`} desc={desc} path={`/category/${c.path}/`} noindex={!lv.length} alts={alts} keywords={[...(HUBKW[c.slug]||[]),'free online tools','best free tools','worlds best free tools']} ld={ld}>
<p class="crumbs"><a href="/">Home</a> / {c.name}</p><div class="hero"><Fragment set:html={iconFor({slug:c.slug,cat:c.slug},'big')}/><h1>{c.name}</h1></div>
<p class="lead">{info}</p>
<div class="grid" style="margin-top:24px">{lv.map(t=>(<a href={`/${t.slug}/`}><Fragment set:html={iconFor(t)}/><span>{t.name}</span></a>))}</div>
{sr.length>0&&<section><h2>Popular searches</h2><div class="chips" style="margin-top:0">{sr.map(([label,sl])=><a href={`/${sl}/`}>{label}</a>)}</div></section>}
<section><h2>Frequently asked questions</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
{ts.some(t=>!t.live)?<section><h2>Coming soon</h2><ul class="tags">{ts.filter(t=>!t.live).map(t=>(<li>{t.name}</li>))}</ul></section>:null}
<section><h2>More free online tools</h2><p class="chips" style="margin-top:0">{cats.filter(x=>x.slug!==c.slug).map(x=><a href={`/category/${x.path}/`}>{x.name}</a>)}</p></section>
</Base>
