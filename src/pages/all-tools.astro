---
import Base from '../layouts/Base.astro';
import {cats,live,SITE} from '../data/tools.mjs';
import {LANGS,homeAlts} from '../i18n/index.mjs';
import {posts} from '../lib/blog.mjs';
const groups=cats.map(c=>({c,items:live.filter(t=>t.cat===c.slug)})).filter(g=>g.items.length);
const ld=[{'@type':'CollectionPage',name:'All free online tools',url:SITE+'/all-tools/'},{'@type':'BreadcrumbList',itemListElement:[['Home',SITE+'/'],['All tools',SITE+'/all-tools/']].map(([name,item],i)=>({'@type':'ListItem',position:i+1,name,item}))}];
---
<Base title="All Free Online Tools: Complete List of Free Tools" desc={`Complete list of all ${live.length} free online tools on Worlds Best Free Tools: calculators, PDF, image, QR, video link and file tools. No signup.`} path="/all-tools/" keywords={['all free online tools','free tools list','best free tools','worlds best free tools']} ld={ld}>
<p class="crumbs"><a href="/">Home</a> / All tools</p><h1>All free online tools</h1>
<p class="lead">Every free tool on Worlds Best Free Tools, grouped by category. No signup, no watermark, runs in your browser.</p>
{groups.map(g=><section class="cat"><h2><a href={`/category/${g.c.slug}/`}>{g.c.name}</a></h2><ul class="alist">{g.items.map(t=><li><a href={`/${t.slug}/`}>{t.name}</a></li>)}</ul></section>)}
<section class="cat"><h2>Guides and articles</h2><ul class="alist">{posts.map(p=><li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>)}</ul></section>
<section class="cat"><h2>Translated versions</h2><ul class="alist">{homeAlts().filter(a=>a.code!=='en').map(a=><li><a href={a.url} hreflang={a.lang} lang={a.lang}>{a.name}</a></li>)}</ul></section>
</Base>
