---
import {cats,SITE} from '../data/tools.mjs';
const {title,desc,path='/',noindex=false,ld=[],md=''}=Astro.props;
const url=SITE+path;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={desc}><link rel="canonical" href={url}>{md&&<link rel="alternate" type="text/markdown" href={md}>}<link rel="ard" href="/.well-known/ard.json">
<meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}>
<meta property="og:type" content="website"><meta property="og:site_name" content="WorldsBestFreeTools"><meta property="og:title" content={title}><meta property="og:description" content={desc}><meta property="og:url" content={url}>
<meta name="twitter:card" content="summary"><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23c8301a'/><path d='M8 10h16M8 16h16M8 22h10' stroke='white' stroke-width='3' stroke-linecap='round'/></svg>">
{ld.map(o=><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...o})}/>)}
</head><body>
<header><a class="logo" href="/">Worlds<b>Best</b>FreeTools</a><nav><a href="/category/finance/">Calculators</a><a href="/category/image/">Image</a><a href="/category/pdf/">PDF</a><a href="/category/qr/">QR</a></nav></header>
<main><slot/></main>
<footer><div class="wrap"><p><b>WorldsBestFreeTools</b>: free online tools that run in your browser. Link to any tool freely; we welcome backlinks.</p><div class="fcats">{cats.map(c=><a href={`/category/${c.slug}/`}>{c.name}</a>)}</div></div></footer>
<style is:global>
:root{--bg:#fbfaf7;--ink:#15171c;--mut:#5d6470;--line:#e4e1d8;--card:#fff;--acc:#c8301a;--r:12px}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--acc)}header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px max(16px,calc(50% - 560px));border-bottom:1px solid var(--line);background:var(--card)}
.logo{font-weight:800;letter-spacing:-.03em;font-size:1.15rem;color:var(--ink);text-decoration:none}.logo b{color:var(--acc)}nav{display:flex;gap:16px;flex-wrap:wrap}nav a{color:var(--ink);text-decoration:none;font-size:.95rem}
main,.wrap{max-width:1120px;margin:0 auto;padding:32px 16px}h1{font-size:clamp(1.9rem,4vw,3rem);line-height:1.1;letter-spacing:-.035em;margin:0 0 12px}h2{font-size:1.35rem;letter-spacing:-.02em;margin:32px 0 12px}
.lead{color:var(--mut);max-width:62ch;font-size:1.1rem}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.grid a{display:block;padding:14px 16px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);color:var(--ink);text-decoration:none;font-weight:600;transition:border-color .15s,transform .15s}.grid a:hover,.grid a:focus-visible{border-color:var(--acc);transform:translateY(-2px)}.grid small{display:block;color:var(--mut);font-weight:400}
.search{width:100%;max-width:520px;padding:14px 16px;font-size:1rem;border:2px solid var(--ink);border-radius:var(--r);margin:20px 0}
.tool{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px;margin:20px 0}.tool label{display:block;font-weight:600;font-size:.9rem;margin:0 0 12px}
.tool input,.tool select,.tool textarea,.tool button{font:inherit;padding:10px 12px;border:1px solid #c9c5b8;border-radius:8px;width:100%;margin-top:4px;background:#fff}.tool textarea{min-height:140px}
.tool button,.btn{background:var(--ink);color:#fff;border:0;cursor:pointer;font-weight:600;width:auto;padding:10px 16px;text-decoration:none;display:inline-block;border-radius:8px;margin:4px 6px 4px 0}.tool button:hover{background:var(--acc)}
:focus-visible{outline:3px solid #1b5cff;outline-offset:2px}.out{background:#f3f1ea;border-radius:8px;padding:14px;margin-top:12px;font-size:1.05rem}.out b{font-size:1.3rem}.out img{max-width:100%;height:auto;display:block;margin-bottom:8px}
.crumbs{font-size:.9rem;color:var(--mut)}.crumbs a{color:var(--mut)}details{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin:8px 0}summary{cursor:pointer;font-weight:600}
.tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none}.tags li{background:#efece3;border-radius:99px;padding:4px 12px;font-size:.9rem}.row{display:flex;gap:8px;flex-wrap:wrap}.ruler{position:relative;height:70px;background:#fff7d6;border:1px solid #999;overflow:hidden}.ruler span{position:absolute;top:34px;font-size:11px}
footer{border-top:1px solid var(--line);background:var(--card);color:var(--mut);margin-top:48px}.fcats{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.9rem}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style></body></html>
