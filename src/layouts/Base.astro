---
import {cats,live,SITE} from '../data/tools.mjs';
import {POPULAR} from '../data/categories.mjs';
import {langGroups,langCodes} from '../data/languages.mjs';
import {LANGS} from '../i18n/index.mjs';
const {title,desc,path='/',noindex=false,ld=[],md='',type='website',keywords=[],lang='en',alts=[]}=Astro.props;
const url=SITE+path;
const BR='Worlds Best Free Tools';
const ui=LANGS[lang]?.ui||{};const L=(k,d)=>ui[k]||d;const home=lang==='en'?'/':`/${lang}/`;
const ogLocale=LANGS[lang]?.locale||'en_US';const dir=LANGS[lang]?.dir||'ltr';const hl=LANGS[lang]?.hreflang||lang;const pgt=LANGS[lang]?.gt||lang;
const dsc=desc.length>160?desc.slice(0,157).replace(/\s+\S*$/,'')+'…':desc;
const core=title.replace(/\s*[|\-–]\s*Worlds ?Best ?Free ?Tools\s*$/i,'');
const full=/worlds ?best ?free ?tools/i.test(core)?core:(`${core} | ${BR}`.length<=72?`${core} | ${BR}`:core);
const img=SITE+'/og-image.png';
const pop=POPULAR.map(sl=>live.find(t=>t.slug===sl)).filter(Boolean);
---
<!doctype html><html lang={hl} dir={dir}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={dsc}>{keywords.length>0&&<meta name="keywords" content={keywords.join(', ')}>}<link rel="canonical" href={url}>{alts.map(a=><link rel="alternate" hreflang={a.lang} href={SITE+a.url}/>)}{alts.length>0&&<link rel="alternate" hreflang="x-default" href={SITE+alts[0].url}/>}{md&&<link rel="alternate" type="text/markdown" href={md}>}<link rel="ard" href="/.well-known/ard.json"><link rel="alternate" type="application/rss+xml" title="WorldsBestFreeTools Blog" href="/blog/rss.xml"><link rel="service-desc" type="application/openapi+json" href="/openapi.json"><link rel="describedby" type="text/plain" href="/llms.txt">
<meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}><meta name="googlebot" content={noindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}><meta name="color-scheme" content="light"><meta name="format-detection" content="telephone=no"><link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
<meta property="og:type" content={type}><meta property="og:site_name" content="Worlds Best Free Tools"><meta property="og:locale" content={ogLocale}><meta property="og:title" content={full}><meta property="og:image" content={img}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Worlds Best Free Tools: free online calculators, PDF, image and QR tools"><meta property="og:description" content={dsc}><meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={full}><meta name="twitter:description" content={dsc}><meta name="twitter:image" content={img}><meta name="application-name" content="Worlds Best Free Tools"><meta name="theme-color" content="#c8301a"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
{ld.map(o=><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...o})}/>)}
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="logo" href={home}>Worlds<b>Best</b>FreeTools</a><div class="hsearch"><input type="search" data-search placeholder={L('search_ph','Search all tools…')} aria-label={L('search_ph','Search all tools…')} autocomplete="off" enterkeyhint="search"></div><nav aria-label="Main"><a href="/category/finance/">{L('nav_calc','Calculators')}</a><a href="/category/image/">{L('nav_image','Image')}</a><a href="/category/pdf/">{L('nav_pdf','PDF')}</a><a href="/category/qr/">{L('nav_qr','QR')}</a><a href="/category/download/">{L('nav_dl','Download')}</a><a href="/all-tools/">{L('nav_all','All tools')}</a><a href="/blog/">{L('nav_blog','Blog')}</a></nav><select id="lang" class="notranslate" translate="no" aria-label="Translate this website / Language"><option value="en">🌐 English</option>{langGroups.map(([g,ls])=><optgroup label={g}>{ls.map(([c,n])=><option value={c}>{n}</option>)}</optgroup>)}</select></header><div id="google_translate_element" hidden></div>
<main id="main"><slot/></main>
<footer><div class="wrap fgrid"><div><p class="fb"><b>Worlds Best Free Tools</b></p><p>Free online tools that run in your browser: calculators, PDF, image, QR, video link and file download tools. No signup. Link to any tool freely; we welcome backlinks. Page translation is automatic where no translated page exists and may be imperfect.</p></div><div><h2 class="fh">{L('cats_h','Categories')}</h2><div class="fcats">{cats.map(c=><a href={`/category/${c.path}/`}>{c.name}</a>)}</div></div><div><h2 class="fh">{L('pop_h','Popular free tools')}</h2><ul class="fpop">{pop.map(t=><li><a href={`/${t.slug}/`}>{t.name}</a></li>)}</ul></div></div><div class="wrap fbot"><p class="flinks"><a href="/all-tools/">{L('nav_all','All tools')}</a> · <a href="/blog/">{L('nav_blog','Blog')}</a> · <a href="/about-us/">{L('about','About Us')}</a> · <a href="/contact-us/">{L('contact','Contact Us')}</a> · <a href="/privacy-policy/">{L('privacy','Privacy Policy')}</a> · <a href="/terms-and-conditions/">{L('terms','Terms and Conditions')}</a> · <a href="/llms.txt">llms.txt</a> · <a href="/sitemap-index.xml">Sitemap</a></p><p><small>© {new Date().getFullYear()} Worlds Best Free Tools (worldsbestfreetools.online)</small></p></div></footer>
<script is:inline define:vars={{pageCode:lang}}>
(function(){var C={};function load(cb){if(C.d)return cb(C.d);fetch('/search-index/'+pageCode+'.json').then(function(r){return r.json()}).then(function(d){C.d=d;cb(d)}).catch(function(){cb([])})}
function init(inp){var box=document.createElement('ul');box.className='sres';box.hidden=true;box.setAttribute('role','listbox');inp.parentNode.style.position='relative';inp.parentNode.appendChild(box);var sel=-1;
function show(q){q=q.trim().toLowerCase();if(!q){box.hidden=true;return}var t=q.split(/\s+/);load(function(d){var r=[];for(var i=0;i<d.length;i++){var h=(d[i][0]+' '+d[i][2]).toLowerCase(),ok=true;for(var j=0;j<t.length;j++)if(h.indexOf(t[j])<0){ok=false;break}if(ok)r.push([d[i][0].toLowerCase().indexOf(t[0])===0?0:d[i][0].toLowerCase().indexOf(t[0])>0?1:2,d[i]])}r.sort(function(a,b){return a[0]-b[0]});r=r.slice(0,8);sel=-1;box.innerHTML=r.length?r.map(function(x){return '<li><a href="'+x[1][1]+'">'+x[1][0].replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</a></li>'}).join(''):'<li class="none">No tool found</li>';box.hidden=false})}
inp.addEventListener('input',function(){show(inp.value)});inp.addEventListener('focus',function(){load(function(){});if(inp.value)show(inp.value)});
inp.addEventListener('keydown',function(e){var a=box.querySelectorAll('a');if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();if(!a.length)return;sel=(sel+(e.key==='ArrowDown'?1:-1)+a.length)%a.length;a.forEach(function(x,i){x.classList.toggle('on',i===sel)})}else if(e.key==='Enter'){var t=a[sel<0?0:sel];if(t){e.preventDefault();location.href=t.href}}else if(e.key==='Escape'){box.hidden=true}});
document.addEventListener('click',function(e){if(!inp.parentNode.contains(e.target))box.hidden=true})}
document.querySelectorAll('[data-search]').forEach(init)})();
</script>
<style is:global>
