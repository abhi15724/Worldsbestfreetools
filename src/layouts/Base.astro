---
import {cats,SITE} from '../data/tools.mjs';
import {langGroups,langCodes} from '../data/languages.mjs';
const {title,desc,path='/',noindex=false,ld=[],md='',type='website'}=Astro.props;
const url=SITE+path;
const BR='Worlds Best Free Tools';
const core=title.replace(/\s*[|\-–]\s*Worlds ?Best ?Free ?Tools\s*$/i,'');
const full=/worlds ?best ?free ?tools/i.test(core)?core:(`${core} | ${BR}`.length<=72?`${core} | ${BR}`:core);
const img=SITE+'/og-image.png';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={desc}><link rel="canonical" href={url}>{md&&<link rel="alternate" type="text/markdown" href={md}>}<link rel="ard" href="/.well-known/ard.json"><link rel="alternate" type="application/rss+xml" title="WorldsBestFreeTools Blog" href="/blog/rss.xml"><link rel="service-desc" type="application/openapi+json" href="/openapi.json"><link rel="describedby" type="text/plain" href="/llms.txt">
<meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}>
<meta property="og:type" content={type}><meta property="og:site_name" content="Worlds Best Free Tools"><meta property="og:locale" content="en_US"><meta property="og:title" content={full}><meta property="og:image" content={img}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Worlds Best Free Tools: free online calculators, PDF, image and QR tools"><meta property="og:description" content={desc}><meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={full}><meta name="twitter:description" content={desc}><meta name="twitter:image" content={img}><meta name="application-name" content="Worlds Best Free Tools"><meta name="theme-color" content="#c8301a"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
{ld.map(o=><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...o})}/>)}
</head><body>
<header><a class="logo" href="/">Worlds<b>Best</b>FreeTools</a><nav><a href="/category/finance/">Calculators</a><a href="/category/image/">Image</a><a href="/category/pdf/">PDF</a><a href="/category/qr/">QR</a><a href="/blog/">Blog</a></nav><select id="lang" class="notranslate" translate="no" aria-label="Translate this website / Language"><option value="en">🌐 English</option>{langGroups.map(([g,ls])=><optgroup label={g}>{ls.map(([c,n])=><option value={c}>{n}</option>)}</optgroup>)}</select></header><div id="google_translate_element" hidden></div>
<main><slot/></main>
<footer><div class="wrap"><p><b>Worlds Best Free Tools</b>: free online tools that run in your browser. Link to any tool freely; we welcome backlinks. Page translation is automatic and powered by Google Translate, so wording may be imperfect.</p><div class="fcats">{cats.map(c=><a href={`/category/${c.slug}/`}>{c.name}</a>)}</div><p class="flinks"><a href="/blog/">Blog</a> · <a href="/about-us/">About Us</a> · <a href="/contact-us/">Contact Us</a> · <a href="/privacy-policy/">Privacy Policy</a> · <a href="/terms-and-conditions/">Terms and Conditions</a></p><p><small>© {new Date().getFullYear()} Worlds Best Free Tools (worldsbestfreetools.online)</small></p></div></footer>
<style is:global>
:root{--bg:#fbfaf7;--ink:#15171c;--mut:#5d6470;--line:#e4e1d8;--card:#fff;--acc:#c8301a;--r:12px}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--acc)}header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px max(16px,calc(50% - 560px));border-bottom:1px solid var(--line);background:var(--card)}
.logo{font-weight:800;letter-spacing:-.03em;font-size:1.15rem;color:var(--ink);text-decoration:none}.logo b{color:var(--acc)}nav{display:flex;gap:16px;flex-wrap:wrap}nav a{color:var(--ink);text-decoration:none;font-size:.95rem}
main,.wrap{max-width:1120px;margin:0 auto;padding:32px 16px}h1{font-size:clamp(1.9rem,4vw,3rem);line-height:1.1;letter-spacing:-.035em;margin:0 0 12px}h2{font-size:1.35rem;letter-spacing:-.02em;margin:32px 0 12px}
.lead{color:var(--mut);max-width:62ch;font-size:1.1rem}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.grid a{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:16px 14px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);color:var(--ink);text-decoration:none;font-weight:600;transition:border-color .15s,transform .15s}.grid a:hover,.grid a:focus-visible{border-color:var(--acc);transform:translateY(-2px)}.grid small{display:block;color:var(--mut);font-weight:400}
.search{width:100%;max-width:520px;padding:14px 16px;font-size:1rem;border:2px solid var(--ink);border-radius:var(--r);margin:20px 0}
.tool{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px;margin:20px 0}.tool label{display:block;font-weight:600;font-size:.9rem;margin:0 0 12px}
.tool input,.tool select,.tool textarea,.tool button{font:inherit;padding:10px 12px;border:1px solid #c9c5b8;border-radius:8px;width:100%;margin-top:4px;background:#fff}.tool textarea{min-height:140px}
.tool button,.btn{background:var(--ink);color:#fff;border:0;cursor:pointer;font-weight:600;width:auto;padding:10px 16px;text-decoration:none;display:inline-block;border-radius:8px;margin:4px 6px 4px 0}.tool button:hover{background:var(--acc)}
:focus-visible{outline:3px solid #1b5cff;outline-offset:2px}.out{background:#f3f1ea;border-radius:8px;padding:14px;margin-top:12px;font-size:1.05rem}.out b{font-size:1.3rem}.out img{max-width:100%;height:auto;display:block;margin-bottom:8px}
.crumbs{font-size:.9rem;color:var(--mut)}.crumbs a{color:var(--mut)}details{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin:8px 0}summary{cursor:pointer;font-weight:600}
.tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none}.tags li{background:#efece3;border-radius:99px;padding:4px 12px;font-size:.9rem}.row{display:flex;gap:8px;flex-wrap:wrap}.ruler{position:relative;height:70px;background:#fff7d6;border:1px solid #999;overflow:hidden}.ruler span{position:absolute;top:34px;font-size:11px}
footer{border-top:1px solid var(--line);background:var(--card);color:var(--mut);margin-top:48px}.fcats{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.9rem}
main{text-align:center}main h1,main h2,main .lead,main .crumbs{text-align:center}main .lead{margin-left:auto;margin-right:auto}
.search{display:block;margin:20px auto}.tags{justify-content:center}.row{justify-content:center}
.tool,details,.prose p,.prose li,.prose table,.prose .quick,.prose .note,.prose h2,.prose h3,main>ol,main>ul:not(.tags){text-align:left}
main>ol,main>ul:not(.tags){display:table;margin-left:auto;margin-right:auto}
.prose{margin:0 auto}.prose .cta,.prose .byline,.prose .meta{text-align:center}.prose .lead{text-align:center}.prose p,.prose li{margin-left:auto;margin-right:auto}.prose ul,.prose ol{display:table;margin-left:auto;margin-right:auto}
details{max-width:760px;margin-left:auto;margin-right:auto}.out{text-align:center}
.ico{display:inline-grid;place-items:center;width:46px;height:46px;border-radius:12px;background:#f3f1ea;background:color-mix(in srgb,var(--c) 13%,#fff);color:var(--c);flex:none}.ico.big{width:68px;height:68px;border-radius:18px;margin:0 auto 14px}.grid .ico{margin-bottom:2px}
.hero{display:flex;flex-direction:column;align-items:center;text-align:center}
footer,footer .wrap{text-align:center}.fcats{justify-content:center}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style><script is:inline define:vars={{codes:langCodes.join(',')}}>
(function(){
var sel=document.getElementById('lang');if(!sel)return;
function getLang(){var m=document.cookie.match(/(?:^|; )googtrans=\/[^\/]*\/([^;]+)/);return m?decodeURIComponent(m[1]):'en'}
function setCookie(v){var h=location.hostname,exp=v?'':';expires=Thu, 01 Jan 1970 00:00:00 GMT',val=v?'/en/'+v:'';
 document.cookie='googtrans='+val+';path=/'+exp;
 if(h.indexOf('.')>-1){document.cookie='googtrans='+val+';path=/;domain='+h+exp;document.cookie='googtrans='+val+';path=/;domain=.'+h.replace(/^www\./,'')+exp}}
function load(){window.googleTranslateElementInit=function(){new google.translate.TranslateElement({pageLanguage:'en',includedLanguages:codes,autoDisplay:false},'google_translate_element')};
 var s=document.createElement('script');s.src='https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';s.async=true;document.head.appendChild(s)}
var cur=getLang();
if(cur!=='en'&&codes.split(',').indexOf(cur)>-1){sel.value=cur;load()}
sel.addEventListener('change',function(){var v=sel.value;try{localStorage.setItem('wbft-lang',v)}catch(e){}
 setCookie(v==='en'?'':v);location.reload()});
})();
</script>
<style is:global>
.skiptranslate iframe,.goog-te-banner-frame,#goog-gt-tt,.goog-tooltip,.goog-te-balloon-frame{display:none!important}
body{top:0!important}.goog-text-highlight{background:none!important;box-shadow:none!important}
#lang{font:inherit;font-size:.9rem;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);max-width:200px;cursor:pointer}
header{flex-wrap:wrap}.flinks{font-size:.9rem}.flinks a{color:var(--ink)}
</style></body></html>
