{
 "trailingSlash": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Link",
     "value": "</.well-known/ard.json>; rel=\"ard\", </openapi.json>; rel=\"service-desc\"; type=\"application/openapi+json\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(self)"
    }
   ]
  },
  {
   "source": "/_astro/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/md/(.*)",
   "headers": [
    {
     "key": "Content-Type",
     "value": "text/markdown; charset=utf-8"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  },
  {
   "source": "/.well-known/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/openapi.json",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/(.*)\\.(png|ico|svg|webmanifest)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/search-index/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ],
